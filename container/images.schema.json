{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sentenz/container/blob/main/container/images.schema.json",
  "title": "Container image catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "images"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "file",
          "platforms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^container/[a-z0-9]+(?:[._-][a-z0-9]+)*/Containerfile$"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ]
            }
          }
        }
      }
    }
  }
}
